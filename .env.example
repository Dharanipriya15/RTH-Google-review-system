# ---------------------------------------------------------------------------
# Public — inlined into the browser bundle. Never put secrets here.
# ---------------------------------------------------------------------------

# Canonical site URL (used for auth redirects and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. The anon key is safe for the browser; all tables are
# protected by Row Level Security with no anon policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Fallback Google review URL, used only if businesses.google_review_url is empty
# (that DB column is the source of truth). Use a link that opens the review
# dialog directly, e.g. https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID

# ---------------------------------------------------------------------------
# Server-only — never exposed to the browser. Set these in your host's
# environment settings in production; never commit real values.
# ---------------------------------------------------------------------------

# Supabase service-role key. Bypasses RLS. Used only in server route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Feedback sink — REQUIRED for 1–3 star (private) feedback submissions.
# The Apps Script web app appends the row to the Feedback sheet AND emails the
# owner. A submission is reported as failed to the customer if these are unset
# or the call fails (see src/lib/feedback/sink.ts). NO Google Cloud service
# account is needed — the script runs as you and writes your own sheet.
#
# Setup: deploy apps-script/Code.gs as a Web app (Deploy > New deployment >
# Web app; Execute as: Me; Who has access: Anyone), then paste its /exec URL
# below. APPS_SCRIPT_NOTIFY_SECRET must match the script's NOTIFY_SHARED_SECRET
# script property.
# ---------------------------------------------------------------------------
APPS_SCRIPT_NOTIFY_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
APPS_SCRIPT_NOTIFY_SECRET=replace-with-a-long-random-string

# Long random string used to salt the stored IP hash (raw IPs are never stored).
FEEDBACK_IP_HASH_SALT=replace-with-a-long-random-string

# In-memory rate limit for POST /api/feedback (per client IP).
RATE_LIMIT_MAX_PER_WINDOW=3
RATE_LIMIT_WINDOW_SECONDS=600
